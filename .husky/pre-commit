#!/usr/bin/env sh
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|jsx)$' | grep -v node_modules || true)
[ -z "$STAGED" ] && exit 0
node -e "
var fs=require('fs'),files=process.argv.slice(1),err=0;
files.forEach(function(f){
  if(!fs.existsSync(f))return;
  var c=fs.readFileSync(f,'utf8');
  if(/[\u2018\u2019\u201C\u201D]/.test(c)){console.log('BLOCKED: curly quotes in '+f);err=1;}
});
if(err)process.exit(1);
" $STAGED