// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  firstName String?
  lastName  String?
  username  String?
  xp        Int      @default(0)
  level     Int      @default(1)
  streak    Int      @default(0)
  lastStreakDate DateTime?
  invitationCode String? @unique
  parentInvitationCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  badges        UserBadge[]
  quizAttempts  QuizAttempt[]
  flashcardReviews FlashcardReview[]
  solverHistory SolverHistory[]
  forumDiscussions ForumDiscussion[]
  forumReplies  ForumReply[]
  challengeAttempts ChallengeAttempt[]
  duelParticipations DuelParticipation[]
  microLessonCompletions MicroLessonCompletion[]
  coachSessions CoachSession[]
  subscriptions Subscription[]
  payments     Payment[]

  @@map("users")
  @@index([email])
  @@index([username])
}

// Badges
model Badge {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String
  color       String
  category    String
  requirement String
  createdAt   DateTime @default(now())

  userBadges UserBadge[]

  @@map("badges")
  @@index([category])
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now()) @map("earnedAt")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@map("user_badges")
  @@unique([userId, badgeId])
  @@index([userId])
}

// Quiz & Question Banks
model QuestionBank {
  id             String   @id @default(cuid())
  title          String
  subject        String
  level          String
  type           String
  description    String?
  totalQuestions Int      @default(0) @map("total_questions")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  questions    Question[]
  quizAttempts QuizAttempt[]

  @@map("question_banks")
  @@index([subject, level])
  @@index([type])
}

model Question {
  id            String   @id @default(cuid())
  bankId        String
  question      String
  type          String
  difficulty    Int      @default(3)
  subject       String?
  level         String?
  options       Json?
  correctAnswer Int?
  explanation   String?
  createdAt     DateTime @default(now())

  bank QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@index([bankId])
  @@index([subject, level])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  bankId      String?  @map("quizId")
  score       Int
  total       Int      @default(0)
  answers     Json
  startedAt   DateTime @default(now())
  completedAt DateTime?

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank QuestionBank? @relation(fields: [bankId], references: [id], onDelete: SetNull)

  @@map("quiz_attempts")
  @@index([userId])
  @@index([bankId])
}

// Flashcards
model Flashcard {
  id        String   @id @default(cuid())
  userId    String?
  front     String   @map("question")
  back      String   @map("answer")
  subject   String?
  level     String?
  createdAt DateTime @default(now())

  reviews FlashcardReview[]

  @@map("flashcards")
  @@index([userId])
}

model FlashcardReview {
  id          String   @id @default(cuid())
  flashcardId String
  userId      String
  quality     Int
  nextReview  DateTime
  interval    Int      @default(1)
  easeFactor  Float    @default(2.5)
  repetitions Int      @default(0)
  reviewedAt  DateTime @default(now())

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("flashcard_reviews")
  @@unique([flashcardId, userId])
  @@index([userId, nextReview])
}

// Challenges
model Challenge {
  id           String   @id @default(cuid())
  title        String
  description  String
  subject      String
  level        String
  difficulty   String
  timeLimit    Int
  questions    Json
  isActive     Boolean  @default(true)
  startDate    DateTime
  endDate      DateTime
  participants Int      @default(0)
  createdAt    DateTime @default(now())

  attempts ChallengeAttempt[]

  @@index([isActive, startDate, endDate])
}

model ChallengeAttempt {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  score       Int
  rank        Int?
  answers     Json
  timeSpent   Int
  startedAt   DateTime @default(now())
  completedAt DateTime?

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([challengeId, score])
  @@index([userId])
}

// Duels
model Duel {
  id           String   @id @default(cuid())
  challengerId String
  opponentId   String?
  isPublic     Boolean  @default(false)
  status       String   @default("pending")
  questions    Json?
  winnerId     String?
  startedAt    DateTime?
  completedAt  DateTime?

  participations DuelParticipation[]

  @@index([challengerId, opponentId])
  @@index([status])
}

model DuelParticipation {
  id        String  @id @default(cuid())
  duelId    String
  userId    String
  score     Int     @default(0)
  answers   Json?
  completed Boolean @default(false)

  duel Duel @relation(fields: [duelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([duelId, userId])
  @@index([userId])
}

// Solver (IA)
model SolverHistory {
  id        String   @id @default(cuid())
  userId    String
  problem   String
  subject   String?
  level     String?
  solution  Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subject, level])
}

// Forum
model ForumDiscussion {
  id           String   @id @default(cuid())
  userId       String
  title        String
  content      String
  subject      String?
  level        String?
  views        Int      @default(0)
  votes        Int      @default(0) @map("upvotes")
  bestAnswerId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies ForumReply[]

  @@map("discussions")
  @@index([userId])
  @@index([subject, level])
  @@index([createdAt])
}

model ForumReply {
  id           String   @id @default(cuid())
  discussionId String
  userId       String
  content      String
  votes        Int      @default(0) @map("upvotes")
  isBestAnswer Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  discussion ForumDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("replies")
  @@index([discussionId])
  @@index([userId])
}

// Micro-lessons
model MicroLessonCompletion {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  lessonId    String    @map("microlesson_id")
  completed   Boolean   @default(false)
  score       Float?
  timeSpent   Int       @default(0) @map("time_spent")
  xpEarned    Int       @default(0)
  completedAt DateTime? @map("first_completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("microlesson_completions")
  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

// Coach Virtual
model CoachSession {
  id            String   @id @default(cuid())
  userId        String
  equation      String?
  guidanceLevel String?
  steps         Json?
  currentStep   Int      @default(0)
  completed     Boolean  @default(false)
  score         Float?
  startedAt     DateTime @default(now())
  completedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coach_sessions")
  @@index([userId])
}

// Subscription Plans
model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String
  displayName String   @default("")
  description String
  price       Int
  currency    String   @default("XOF")
  interval    String   @default("monthly")
  features    Json
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
  @@index([isActive])
  @@index([name])
}

// Subscriptions
model Subscription {
  id          String    @id @default(cuid())
  userId      String
  planId      String
  status      String
  startDate   DateTime  @default(now())
  endDate     DateTime?
  cancelledAt DateTime?
  autoRenew   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@map("subscriptions")
  @@unique([userId, status])
  @@index([userId])
  @@index([status])
  @@index([endDate])
}

// Payments
model Payment {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  subscriptionId    String?   @map("subscription_id")
  amount            Int
  currency          String    @default("XOF")
  status            String
  paymentMethod     String    @map("payment_type")
  waveCheckoutId    String?   @map("wave_id")
  waveTransactionId String?
  metadata          Json?
  errorMessage      String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@map("payments")
  @@index([userId])
  @@index([status])
  @@index([waveCheckoutId])
}
