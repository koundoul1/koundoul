// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  firstName String?
  lastName  String?
  username  String?
  xp        Int      @default(0)
  level     Int      @default(1)
  streak    Int      @default(0)
  lastStreakDate DateTime?
  invitationCode String? @unique // Code d'invitation pour les parents
  parentInvitationCode String? // Code du parent (si utilisateur est un enfant)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  badges        UserBadge[]
  quizAttempts  QuizAttempt[]
  flashcardReviews FlashcardReview[]
  solverHistory SolverHistory[]
  forumDiscussions ForumDiscussion[]
  forumReplies  ForumReply[]
  challengeAttempts ChallengeAttempt[]
  duelParticipations DuelParticipation[]
  microLessonCompletions MicroLessonCompletion[]
  coachSessions CoachSession[]
  subscriptions Subscription[]
  payments     Payment[]

  @@index([email])
  @@index([username])
}

// Badges
model Badge {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String
  color       String
  category    String
  requirement String
  createdAt   DateTime @default(now())

  userBadges UserBadge[]

  @@index([category])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  unlockedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

// Quiz & Question Banks
model QuestionBank {
  id          String   @id @default(cuid())
  title       String
  subject     String
  level       String
  type        String   // QCM, EXERCISE
  description String?
  totalQuestions Int   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   Question[]
  quizAttempts QuizAttempt[]

  @@index([subject, level])
  @@index([type])
}

model Question {
  id          String   @id @default(cuid())
  bankId      String
  question    String
  type        String   // QCM, EXERCISE
  difficulty  Int      @default(3)
  subject     String?
  level       String?
  options     Json?    // Pour QCM: [{text, is_correct}]
  correctAnswer Int?   // Index de la bonne réponse
  explanation String?
  createdAt   DateTime @default(now())

  bank QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@index([bankId])
  @@index([subject, level])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  bankId      String?
  score       Int
  total       Int
  answers     Json     // {questionId: answerIndex}
  startedAt   DateTime @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank QuestionBank? @relation(fields: [bankId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bankId])
}

// Flashcards
model Flashcard {
  id        String   @id @default(cuid())
  userId    String?
  front     String
  back      String
  subject   String?
  level     String?
  createdAt DateTime @default(now())

  reviews   FlashcardReview[]

  @@index([userId])
}

model FlashcardReview {
  id          String   @id @default(cuid())
  flashcardId String
  userId      String
  quality     Int      // 0-5 (SuperMemo algorithm)
  nextReview  DateTime
  interval    Int      @default(1)
  easeFactor Float     @default(2.5)
  repetitions Int      @default(0)
  reviewedAt  DateTime @default(now())

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([flashcardId, userId])
  @@index([userId, nextReview])
}

// Challenges
model Challenge {
  id          String   @id @default(cuid())
  title       String
  description String
  subject     String
  level       String
  difficulty  String
  timeLimit   Int      // minutes
  questions   Json     // Array of question IDs
  isActive    Boolean  @default(true)
  startDate   DateTime
  endDate     DateTime
  participants Int     @default(0)
  createdAt   DateTime @default(now())

  attempts    ChallengeAttempt[]

  @@index([isActive, startDate, endDate])
}

model ChallengeAttempt {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  score       Int
  rank        Int?
  answers     Json
  timeSpent   Int      // seconds
  startedAt   DateTime @default(now())
  completedAt DateTime?

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([challengeId, score])
  @@index([userId])
}

// Duels
model Duel {
  id          String   @id @default(cuid())
  challengerId String
  opponentId   String?
  isPublic    Boolean  @default(false)
  status      String   @default("pending") // pending, accepted, started, completed
  questions   Json?
  winnerId    String?
  startedAt   DateTime?
  completedAt DateTime?

  participations DuelParticipation[]

  @@index([challengerId, opponentId])
  @@index([status])
}

model DuelParticipation {
  id        String   @id @default(cuid())
  duelId    String
  userId    String
  score     Int      @default(0)
  answers   Json?
  completed Boolean  @default(false)

  duel Duel @relation(fields: [duelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([duelId, userId])
  @@index([userId])
}

// Solver (IA)
model SolverHistory {
  id        String   @id @default(cuid())
  userId    String
  problem   String
  subject   String?
  level     String?
  solution  Json     // {steps, answer, explanation}
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subject, level])
}

// Forum
model ForumDiscussion {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  subject   String?
  level     String?
  views     Int      @default(0)
  votes     Int      @default(0)
  bestAnswerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies ForumReply[]

  @@index([userId])
  @@index([subject, level])
  @@index([createdAt])
}

model ForumReply {
  id           String   @id @default(cuid())
  discussionId String
  userId       String
  content      String
  votes        Int      @default(0)
  isBestAnswer Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  discussion ForumDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@index([userId])
}

// Micro-lessons
model MicroLessonCompletion {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String   // External ID from Supabase
  completed Boolean  @default(false)
  score     Float?
  timeSpent Int      @default(0) // seconds
  xpEarned  Int      @default(0)
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

// Coach Virtual
model CoachSession {
  id          String   @id @default(cuid())
  userId      String
  equation    String
  guidanceLevel String
  steps       Json?
  currentStep Int      @default(0)
  completed   Boolean  @default(false)
  score       Float?
  startedAt   DateTime @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Subscription Plans
model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String   // FREE, PREMIUM, FAMILY
  displayName String
  description String
  price       Int      // En centimes (XOF)
  currency    String   @default("XOF")
  interval    String   // monthly, yearly
  features    Json     // Array of features
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]

  @@index([isActive])
  @@index([name])
}

// Subscriptions
model Subscription {
  id          String   @id @default(cuid())
  userId      String
  planId      String
  status      String   // active, cancelled, expired, pending
  startDate   DateTime @default(now())
  endDate     DateTime?
  cancelledAt DateTime?
  autoRenew   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments    Payment[]

  @@unique([userId, status])
  @@index([userId])
  @@index([status])
  @@index([endDate])
}

// Payments
model Payment {
  id              String   @id @default(cuid())
  userId          String
  subscriptionId  String?
  amount          Int      // En centimes
  currency        String   @default("XOF")
  status          String   // pending, completed, failed, cancelled
  paymentMethod   String   // wave, stripe, orange_money
  waveCheckoutId  String?  // ID de session Wave
  waveTransactionId String? // ID transaction Wave
  metadata        Json?    // Données supplémentaires
  errorMessage    String?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([waveCheckoutId])
  @@index([waveTransactionId])
}
