# KOUNDOUL BACKEND — Variables d'environnement (exemple)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/koundoul
PORT=5000
NODE_ENV=development
# REQUIRED — minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
FRONTEND_URL=http://localhost:3002
SUPABASE_URL=https://wnbkplyerizogmufatxb.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Wave Payment (required for subscription payments)
WAVE_API_KEY=your-wave-api-key
WAVE_WEBHOOK_SECRET=your-wave-webhook-secret

# Email / SMTP (required for password reset emails)
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use an App Password
# Brevo example: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Koundoul <noreply@koundoul.com>

# Google AI / Gemini (optional — AI features disabled if absent)
# Get your key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key
GOOGLE_AI_MODEL_SOLVER=gemini-2.5-pro
GOOGLE_AI_MODEL_COACH=gemini-2.5-flash
